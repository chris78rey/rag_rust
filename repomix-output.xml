  app:
    build: .
    container_name: rag_rust_app
    restart: unless-stopped
    depends_on:
      - qdrant
    env_file:
      - .env
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./data:/app/data
    environment:
      RUST_LOG: info

volumes:
