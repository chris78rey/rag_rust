# Copiar este archivo a .env
# cp .env.example .env

# Administrador inicial. Se crea solo la primera vez si no existe.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTH_SALT=cambie-esta-sal-local
SESSION_HOURS=24

# OpenRouter se usa para redactar respuesta final y (opcional) expandir consultas.
# Si se deja vacío, el sistema funciona en modo privado.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2-flash
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDINGS_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=rag_chunks
QDRANT_ENABLED=true
EMBEDDING_DIMENSION=1536
SEMANTIC_TOP_K=24
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0
EMBEDDING_BATCH_SIZE=16

# Expansión de preguntas con LLM: genera variantes de búsqueda antes de consultar.
# true = activa, false (o vacío) = solo búsqueda léxica local.
# Requiere OPENROUTER_API_KEY configurada.
LLM_QUERY_EXPANSION=true

# ===== MODO DE PRECISIÓN DOCUMENTAL (agnóstico al dominio) =====
# Activa detección de siglas, fórmulas, porcentajes, reglas y condiciones
# en cualquier documento, sin depender de términos específicos del dominio.
EXACT_EVIDENCE_MODE=true

# Iteraciones máximas de búsqueda interna
MAX_SEARCH_ITERATIONS=8

# Máximo de preguntas internas generadas por consulta
MAX_INTERNAL_QUESTIONS=40

# Máximo de fragmentos en el expediente interno
MAX_FRAGMENTS_INTERNAL=80

# Fragmentos finales enviados al LLM para redactar
FINAL_CONTEXT_FRAGMENTS=12

# Buscar evidencia relacionada que el usuario no preguntó
ENABLE_RELATED_EVIDENCE=true

DOCS_DIR=/app/data/documents
STATE_DIR=/app/data/state

# RAG léxico local: SQLite FTS5/BM25. No usa embeddings ni Qdrant.
INDEX_INTERVAL_SECONDS=3600
DEFAULT_TOP_K=6
ANSWER_MAX_WORDS=100

APP_HOST=0.0.0.0
APP_PORT=8080
